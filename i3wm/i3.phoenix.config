{
  "fontsize": "11",
  "smart_terminal_command": "i3-smart-terminal",
  "smart_terminal_lo_dpi_zoom": 1.1,
  "smart_terminal_hi_dpi_zoom": 1.2,
  "smart_terminal_terminal_command": "mate-terminal",
  "floating_terminal_command": "i3-smart-terminal",
  "floating_terminal_args": "--role=floating_terminal",
  "floating_terminal_window_props": "instance=\"mate-terminal\" window_role=\"floating_terminal\"",
  "pa_sink": "1",
  "settings_manager": "mate-control-center",
  "startup_programs":
    [
    "xcompmgr -c -l0 -t0 -r0 -o.00",
    "/usr/libexec/mate-settings-daemon",
    "lock-screensaver-on-activate.py",
    "/usr/libexec/polkit-mate-authentication-agent-1",
    "next_wallpaper.sh \":0\" startup",
    "~/.local/bin/g500-accel.sh",
    "zoom"
    ],
  "i3status_config": "~/.dotfiles/i3wm/i3status.phoenix.config"
}
